# BMO Configuration File - Example Template
# Copy this file to config/config.yaml and customize for your setup

# Project metadata
project:
  name: "BMO"
  version: "4.1"
  user_name: "YourName"  # Change this to your name

# LLM Configuration
llm:
  provider: "groq"
  model_name: "llama-3.1-8b-instant"  # Options: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768

  # Temperature settings for different use cases
  temperatures:
    router: 0.0      # Precise routing decisions (0.0-1.0, lower = more deterministic)
    agent: 0.7       # Creative responses with tools (0.0-2.0, higher = more creative)
    conversation: 0.7 # Natural conversation flow (0.0-2.0)

  # Agent execution settings
  agent:
    max_iterations: 5            # Maximum number of tool calls per request
    verbose: true                # Print detailed agent execution logs
    handle_parsing_errors: true  # Gracefully handle malformed tool calls

# Text-to-Speech Configuration
tts:
  engine: "google"  # Options: google, coqui, elevenlabs

  # Google Cloud TTS settings
  google:
    voice_name: "pt-BR-Chirp3-HD-Erinome"  # See: https://cloud.google.com/text-to-speech/docs/voices
    language_code: "pt-BR"
    audio_encoding: "MP3"  # Options: MP3, LINEAR16, OGG_OPUS

  # Coqui TTS settings (local, free, slower)
  coqui:
    model: "tts_models/multilingual/multi-dataset/xtts_v2"
    voice_sample_path: "bmo_voice_sample.wav"  # Path to voice sample for cloning
    language: "pt"
    split_sentences: true

  # ElevenLabs settings (future support)
  elevenlabs:
    voice_id: ""

# Speech-to-Text Configuration
stt:
  provider: "groq"
  model: "whisper-large-v3"  # Groq Whisper model
  language: "pt"

# Wake Word Detection
wake_word:
  model_path: "custom_models/wake_word/ei_bmo.onnx"  # Path to custom wake word model
  threshold: 0.5  # Detection threshold (0.0-1.0, higher = less sensitive)
  inference_framework: "onnx"

  # Audio settings for wake word detection
  audio:
    sample_rate: 16000  # 16kHz is standard for wake word
    chunk_size: 1280    # 80ms chunks at 16kHz
    channels: 1         # Mono audio
    format: "int16"

# Audio Recording Settings
recording:
  duration_seconds: 5       # How long to record after wake word
  sample_rate: 16000
  channels: 1
  chunk_size: 1280
  format: "int16"
  input_device_index: null  # null = default mic, or specify device index (use: python -m sounddevice)

  # Buffer management
  buffer_clear_duration_ms: 500  # Clear this much audio after playback to prevent echo

# Spotify Integration
spotify:
  scope: "user-modify-playback-state,user-read-playback-state,user-read-currently-playing"
  redirect_uri: "http://127.0.0.1:9090"

# Google Calendar Integration
google_calendar:
  credentials_file: "credentials.json"
  token_file: "token.json"
  scopes:
    - "https://www.googleapis.com/auth/calendar.readonly"

# Google Cloud Configuration
google_cloud:
  adc_credentials_file: "google_adc_credentials.json"

# Flask Server Configuration
server:
  host: "0.0.0.0"  # 0.0.0.0 = accept connections from any IP
  port: 5000
  debug: false     # Set to true for development (auto-reload on code changes)

# LangChain Settings
langchain:
  tracing_v2: false  # Enable LangSmith tracing for debugging
  api_key: ""        # LangSmith API key (optional)
  endpoint: "https://api.smith.langchain.com"
  project: "bmo_project"

# Paths Configuration (relative to project root)
paths:
  base_dir: "."  # Auto-detected, don't change
  temp_audio: "temp_question.wav"
  response_audio_mp3: "response.mp3"
  response_audio_wav: "response.wav"
  web_folder: "web"
  custom_models: "custom_models"

# Hardware Settings (for Raspberry Pi / embedded deployments)
hardware:
  enabled: false      # Set to true if using GPIO hardware
  gpio_led_pin: null  # GPIO pin for LED indicator (e.g., 18)

  display:
    enabled: false    # Set to true if using a display
    type: null        # Display type: ssd1306, st7789, etc.
    width: 128
    height: 64
